---
import '../styles/global.css';
const { title, description = 'UK IHT Desk' } = Astro.props as { title: string; description?: string };
const _ogImageProp = (Astro.props as any).ogImage; /* og-wiring */
const _ogImageResolved = new URL(String(_ogImageProp || "https://ukinheritance.com/og-image.jpg"), Astro.site ?? Astro.url).href;

---
<!-- GEO_FLEET_BEGIN -->
<link rel="canonical" href={new URL(Astro.url.pathname, "https://ukinheritance.com/")} />
<meta property="og:url" content={new URL(Astro.url.pathname, "https://ukinheritance.com/")} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: Astro.props.title || "UK IHT Desk",
  url: new URL(Astro.url.pathname, "https://ukinheritance.com/").href,
  isPartOf: { "@type": "WebSite", name: "UK IHT Desk", url: "https://ukinheritance.com/" }
})} />
<!-- GEO_FLEET_END -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<title>{(title === 'UK IHT Desk' || title.includes('UK IHT Desk')) ? title : `${title} · UK IHT Desk`}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="UK IHT Desk" />
<meta property="og:type" content="article" />
<meta property="og:image" content={_ogImageResolved} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#7C2D12" />

---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props as { frontmatter: any };
const _ogImageProp = frontmatter?.ogImage || frontmatter?.heroImage || frontmatter?.featured_image || frontmatter?.featuredImage || frontmatter?.coverImage || frontmatter?.image || undefined; /* og-wiring */
const _iso = (v: any) => { if (!v) return undefined; const d = new Date(v); return isNaN(d.getTime()) ? undefined : d.toISOString(); };
const _pub = _iso(frontmatter?.pubDatetime) || _iso(frontmatter?.publishDate) || _iso(frontmatter?.pubDate);
const _article = { datePublished: _pub, dateModified: _iso(frontmatter?.modDatetime) || _iso(frontmatter?.modDate) || _pub, image: _ogImageProp };

---
<BaseLayout ogImage={_ogImageProp} title={frontmatter.title} description={frontmatter.description} article={_article}>
  <article class="mx-auto max-w-2xl px-6 py-12">
    <p class="text-xs uppercase tracking-[0.3em] text-accent text-center">{frontmatter.category}</p>
    <h1 class="font-heading text-3xl text-primary text-center mt-3 mb-6">{frontmatter.title}</h1>
    <div class="text-ink leading-loose"><slot /></div>
  </article>
</BaseLayout>